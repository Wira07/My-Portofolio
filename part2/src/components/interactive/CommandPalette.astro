---
import type { Locale } from "@/lib/i18n";
import { t } from "@/lib/i18n";
import { getProfile } from "@/lib/content";

export interface CommandSearchItem {
  id: string;
  group: "pages" | "work" | "notes" | "actions";
  title: string;
  subtitle?: string;
  href?: string;
  action?: "toggleTheme" | "switchLang" | "copyEmail" | "downloadCv";
  shortcut?: string;
}

interface Props {
  locale: Locale;
  searchItems: CommandSearchItem[];
  switchLangHref: string;
}

const { locale, searchItems, switchLangHref } = Astro.props;
const profile = getProfile();
const groupLabels = {
  pages: t(locale, "palette.groups.pages"),
  work: t(locale, "palette.groups.work"),
  notes: t(locale, "palette.groups.notes"),
  actions: t(locale, "palette.groups.actions")
};
---

<dialog
  id="command-palette"
  aria-labelledby="cmd-palette-title"
  data-switch-lang-href={switchLangHref}
  data-email={`${profile.emailUser}@${profile.emailDomain}`}
  data-cv={profile.documents.cv}
  data-empty-text={t(locale, "palette.empty")}
  class="m-auto w-[min(640px,92vw)] rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)] p-0 text-[var(--text)] backdrop:bg-black/70"
>
  <div class="border-b border-[var(--line)] p-4">
    <div class="flex items-center justify-between gap-2 pb-2">
      <h2 id="cmd-palette-title" class="mono-label text-[var(--text-dim)]">
        {t(locale, "palette.title")}
      </h2>
      <button
        type="button"
        id="cmd-close-btn"
        aria-label="ESC"
        class="rounded-[var(--radius-sm)] border border-[var(--line)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-dim)] hover:text-[var(--text)]"
      >
        ESC
      </button>
    </div>
    <input
      id="cmd-search-input"
      type="search"
      autocomplete="off"
      placeholder={t(locale, "palette.searchPlaceholder")}
      aria-label={t(locale, "palette.searchPlaceholder")}
      class="w-full rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface-2)] px-3.5 py-2.5 text-sm text-[var(--text)] placeholder:text-[var(--text-dim)] focus:border-[var(--accent)] focus:outline-none"
    />
  </div>

  <div id="cmd-results" role="listbox" class="max-h-[55vh] overflow-y-auto p-3">
    {
      (["pages", "work", "notes", "actions"] as const).map((grp) => {
        const items = searchItems.filter((it) => it.group === grp);
        if (!items.length) return null;
        return (
          <div class="mb-3 last:mb-0" data-cmd-group={grp}>
            <div class="px-2 py-1 font-mono text-[10px] uppercase tracking-widest text-[var(--text-dim)]">
              {groupLabels[grp]}
            </div>
            <div class="flex flex-col gap-1">
              {items.map((item) => (
                <button
                  type="button"
                  role="option"
                  aria-selected="false"
                  data-cmd-item
                  data-search={`${item.title} ${item.subtitle || ""} ${grp}`.toLowerCase()}
                  data-href={item.href}
                  data-action={item.action}
                  class="flex w-full items-center justify-between rounded-[var(--radius-md)] border border-transparent px-3 py-2 text-left text-sm transition-colors hover:border-[var(--line)] hover:bg-[var(--surface-2)] aria-selected:border-[var(--accent)] aria-selected:bg-[var(--surface-2)]"
                >
                  <div>
                    <div class="font-medium text-[var(--text)]">{item.title}</div>
                    {item.subtitle && (
                      <div class="font-mono text-[11px] text-[var(--text-dim)]">{item.subtitle}</div>
                    )}
                  </div>
                  {item.shortcut && (
                    <span class="font-mono text-[11px] text-[var(--accent)]">{item.shortcut}</span>
                  )}
                </button>
              ))}
            </div>
          </div>
        );
      })
    }
    <p id="cmd-empty" hidden class="py-8 text-center font-mono text-xs text-[var(--text-dim)]">
      {t(locale, "palette.empty")}
    </p>
  </div>

  <div class="border-t border-[var(--line)] bg-[var(--surface-2)] px-4 py-2 font-mono text-[11px] text-[var(--text-dim)]">
    {t(locale, "palette.hint")}
  </div>
</dialog>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById("command-palette") as HTMLDialogElement | null;
    if (!dialog) return;

    const input = document.getElementById("cmd-search-input") as HTMLInputElement | null;
    const closeBtn = document.getElementById("cmd-close-btn");
    const emptyEl = document.getElementById("cmd-empty");
    const items = Array.from(dialog.querySelectorAll<HTMLButtonElement>("[data-cmd-item]"));
    const groups = Array.from(dialog.querySelectorAll<HTMLElement>("[data-cmd-group]"));

    let activeIdx = 0;

    const getVisibleItems = () => items.filter((el) => !el.hidden);

    const highlight = (idx: number) => {
      const visible = getVisibleItems();
      items.forEach((it) => it.setAttribute("aria-selected", "false"));
      if (!visible.length) return;
      activeIdx = ((idx % visible.length) + visible.length) % visible.length;
      const target = visible[activeIdx];
      target.setAttribute("aria-selected", "true");
      target.scrollIntoView({ block: "nearest" });
    };

    const filterItems = (query: string) => {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;
      items.forEach((btn) => {
        const hay = btn.dataset.search || "";
        const match = !q || hay.includes(q);
        btn.hidden = !match;
        if (match) visibleCount++;
      });
      groups.forEach((grp) => {
        const hasVisible = Array.from(grp.querySelectorAll<HTMLButtonElement>("[data-cmd-item]")).some(
          (b) => !b.hidden
        );
        grp.hidden = !hasVisible;
      });
      if (emptyEl) emptyEl.hidden = visibleCount > 0;
      highlight(0);
    };

    const openPalette = () => {
      if (dialog.open) return;
      dialog.showModal();
      if (input) {
        input.value = "";
        filterItems("");
        input.focus();
      }
    };

    const runItem = async (btn: HTMLButtonElement) => {
      const href = btn.dataset.href;
      const action = btn.dataset.action;
      dialog.close();
      if (href) {
        window.location.href = href;
        return;
      }
      if (action === "toggleTheme") {
        const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
        toggle?.click();
      } else if (action === "switchLang") {
        const langHref = dialog.dataset.switchLangHref;
        if (langHref) window.location.href = langHref;
      } else if (action === "copyEmail") {
        const email = dialog.dataset.email || "";
        try {
          await navigator.clipboard.writeText(email);
        } catch {}
      } else if (action === "downloadCv") {
        const cv = dialog.dataset.cv;
        if (cv) window.open(cv, "_blank", "noopener,noreferrer");
      }
    };

    document.querySelectorAll("[data-cmd-open]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.cmdBound === "true") return;
      (btn as HTMLElement).dataset.cmdBound = "true";
      btn.addEventListener("click", openPalette);
    });

    if (dialog.dataset.bound !== "true") {
      dialog.dataset.bound = "true";
      closeBtn?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });

      input?.addEventListener("input", () => filterItems(input.value));
      input?.addEventListener("keydown", (e) => {
        const visible = getVisibleItems();
        if (e.key === "ArrowDown") {
          e.preventDefault();
          highlight(activeIdx + 1);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          highlight(activeIdx - 1);
        } else if (e.key === "Enter" && visible[activeIdx]) {
          e.preventDefault();
          runItem(visible[activeIdx]);
        }
      });

      items.forEach((btn) => {
        btn.addEventListener("click", () => runItem(btn));
      });
    }

    if ((window as unknown as Record<string, boolean>).__wiraCmdShortcutBound !== true) {
      (window as unknown as Record<string, boolean>).__wiraCmdShortcutBound = true;
      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          const currentDialog = document.getElementById("command-palette") as HTMLDialogElement | null;
          if (!currentDialog) return;
          if (currentDialog.open) currentDialog.close();
          else {
            const inp = document.getElementById("cmd-search-input") as HTMLInputElement | null;
            currentDialog.showModal();
            if (inp) {
              inp.value = "";
              inp.dispatchEvent(new Event("input"));
              inp.focus();
            }
          }
        }
      });
    }
  }

  setupCommandPalette();
  document.addEventListener("astro:after-swap", setupCommandPalette);
</script>

