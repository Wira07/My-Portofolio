---
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";
import {
  getCapabilities,
  getFeaturedWorkEntries,
  getNoteEntries,
  getProcessSteps,
  getProfile,
  getWorkEntries
} from "@/lib/content";
import { buildPersonJsonLd, buildServiceJsonLd } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StatusStrip from "@/components/core/StatusStrip.astro";
import Button from "@/components/core/Button.astro";
import Section from "@/components/core/Section.astro";
import MarqueeStack from "@/components/motion/MarqueeStack.astro";
import CaseCard from "@/components/work/CaseCard.astro";
import CapabilityRow from "@/components/work/CapabilityRow.astro";
import ProcessTimeline from "@/components/work/ProcessTimeline.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [allWorks, featuredWorks, notes] = await Promise.all([
  getWorkEntries(locale),
  getFeaturedWorkEntries(locale),
  getNoteEntries(locale)
]);

const capabilities = getCapabilities();
const processSteps = getProcessSteps();
const profile = getProfile();
const caseMap = Object.fromEntries(allWorks.map((w) => [w.data.slug, w]));

const marqueeItems = [
  "PHP / Laravel",
  "Kotlin / Jetpack Compose",
  "JavaScript / TypeScript",
  "MQTT Telemetry",
  "Python / YOLO11",
  "TensorFlow Lite",
  "Figma Design Systems",
  "MySQL / Room DB",
  "Firebase FCM"
];

const jsonLd = [buildPersonJsonLd(locale), buildServiceJsonLd(locale)];
---

<BaseLayout
  title={`${t(locale, "meta.brand")} — ${profile.ownerName} · ${t(locale, "meta.studioDescriptor")}`}
  description={t(locale, "hero.sub")}
  locale={locale}
  path={localePath(locale, "/")}
  ogSlug="default"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="relative pb-16 pt-12 md:pb-24 md:pt-20">
    <div class="studio-container">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4" data-hero-line>
        <span class="mono-label text-[var(--text-dim)]">{t(locale, "hero.eyebrow")}</span>
        <StatusStrip locale={locale} />
      </div>

      <h1 class="display-h1 max-w-6xl text-[var(--text)]">
        <span class="block" data-hero-line>{t(locale, "hero.headlineLine1")}</span>
        <span class="block" data-hero-line>{t(locale, "hero.headlineLine2")}</span>
        <span class="display-serif block font-normal text-[var(--accent)]" data-hero-line>
          {t(locale, "hero.headlineAccent")}
        </span>
      </h1>

      <div class="my-10 editorial-rule" data-line-draw></div>

      <div class="grid grid-cols-1 items-end gap-8 md:grid-cols-12">
        <p class="md:col-span-7 max-w-2xl text-base md:text-lg leading-relaxed text-[var(--text-dim)]" data-hero-line>
          {t(locale, "hero.sub")}
        </p>

        <div class="md:col-span-5 flex flex-wrap items-center gap-3 md:justify-end" data-hero-line>
          <Button href={localePath(locale, "/engage")} variant="primary" magnetic={true}>
            {t(locale, "hero.ctaPrimary")} →
          </Button>
          <Button href={localePath(locale, "/work")} variant="secondary">
            {t(locale, "hero.ctaSecondary")}
          </Button>
        </div>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          profile.pillars[locale].map((pillar) => (
            <div class="rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] p-5">
              <div class="font-mono text-xs text-[var(--accent)]">{pillar.code}</div>
              <h2 class="mt-2 font-sans text-base font-semibold text-[var(--text)]">{pillar.title}</h2>
              <p class="mt-1.5 text-xs leading-relaxed text-[var(--text-dim)]">{pillar.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <MarqueeStack items={marqueeItems} label={t(locale, "hero.proofStripLabel")} />

  <!-- SELECTED WORK (STACKING CARDS) -->
  <Section
    id="selected-work"
    label={t(locale, "home.workSectionLabel")}
    title={t(locale, "home.workSectionTitle")}
  >
    <Button slot="action" href={localePath(locale, "/work")} variant="secondary">
      {t(locale, "home.workViewAll")} →
    </Button>

    <div class="flex flex-col gap-6">
      {featuredWorks.map((item, idx) => <CaseCard item={item} locale={locale} index={idx} layout="stack" />)}
    </div>
  </Section>

  <!-- CAPABILITIES MATRIX -->
  <Section
    id="capabilities-preview"
    label={t(locale, "home.capLabel")}
    title={t(locale, "home.capTitle")}
    className="bg-[var(--surface)]/40"
  >
    <Button slot="action" href={localePath(locale, "/capabilities")} variant="secondary">
      {t(locale, "home.capViewAll")} →
    </Button>

    <div class="border-t border-[var(--line)]">
      {capabilities.map((cap) => <CapabilityRow capability={cap} locale={locale} caseMap={caseMap} />)}
    </div>
  </Section>

  <!-- PROCESS TIMELINE -->
  <Section
    id="process-preview"
    label={t(locale, "home.processLabel")}
    title={t(locale, "home.processTitle")}
  >
    <Button slot="action" href={localePath(locale, "/process")} variant="secondary">
      {t(locale, "home.processViewAll")} →
    </Button>

    <ProcessTimeline steps={processSteps} locale={locale} />
  </Section>

  <!-- ENGINEERING NOTES -->
  <Section
    id="notes-preview"
    label={t(locale, "home.notesLabel")}
    title={t(locale, "home.notesTitle")}
    className="bg-[var(--surface)]/40"
  >
    <Button slot="action" href={localePath(locale, "/notes")} variant="secondary">
      {t(locale, "home.notesViewAll")} →
    </Button>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        notes.map((note) => (
          <a
            href={localePath(locale, `/notes/${note.data.slug}`)}
            class="group flex flex-col justify-between rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)] p-6 no-underline transition-colors hover:border-[var(--accent)]"
          >
            <div>
              <div class="flex items-center justify-between font-mono text-xs text-[var(--text-dim)]">
                <span>{note.data.publishedAt}</span>
                <span>{note.data.readingTime}</span>
              </div>
              <h3 class="mt-3 font-sans text-lg font-semibold text-[var(--text)] group-hover:text-[var(--accent)]">
                {note.data.title}
              </h3>
              <p class="mt-2 text-sm text-[var(--text-dim)]">{note.data.summary}</p>
            </div>
            <div class="mt-5 flex flex-wrap gap-1.5 border-t border-[var(--line)] pt-4">
              {note.data.tags.slice(0, 3).map((tag) => (
                <span class="rounded-[var(--radius-sm)] bg-[var(--surface-2)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-dim)]">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- ENGAGE BANNER -->
  <section class="border-t border-[var(--line)] py-20">
    <div class="studio-container">
      <div class="rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)] p-8 md:p-12" data-reveal>
        <span class="mono-label text-[var(--accent)]">{t(locale, "home.engageLabel")}</span>
        <div class="mt-4 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <h2 class="page-h1 text-[var(--text)]">{t(locale, "home.engageTitle")}</h2>
            <p class="mt-3 text-base text-[var(--text-dim)]">{t(locale, "home.engageSub")}</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <Button href={localePath(locale, "/engage")} variant="primary" magnetic={true}>
              {t(locale, "hero.ctaPrimary")} →
            </Button>
            <Button href={localePath(locale, "/about")} variant="secondary">
              {t(locale, "nav.about")}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

