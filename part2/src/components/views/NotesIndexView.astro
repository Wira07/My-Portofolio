---
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";
import { getNoteEntries } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const notes = await getNoteEntries(locale);
---

<BaseLayout
  title={`${t(locale, "notes.title")} — ${t(locale, "meta.brand")}`}
  description={t(locale, "notes.subtitle")}
  locale={locale}
  path={localePath(locale, "/notes")}
  ogSlug="default"
  activeNav="notes"
>
  <section class="border-b border-[var(--line)] py-12 md:py-16">
    <div class="studio-container">
      <span class="mono-label text-[var(--accent)]">{t(locale, "home.notesLabel")}</span>
      <h1 class="page-h1 mt-3 max-w-4xl text-[var(--text)]" data-hero-line>{t(locale, "notes.title")}</h1>
      <p class="mt-4 max-w-2xl text-base text-[var(--text-dim)]" data-hero-line>{t(locale, "notes.subtitle")}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="studio-container">
      <div class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
        {
          notes.map((note, idx) => (
            <a
              href={localePath(locale, `/notes/${note.data.slug}`)}
              class="group grid grid-cols-1 gap-4 py-8 no-underline transition-colors hover:bg-[var(--surface)]/50 md:grid-cols-12 md:px-4"
            >
              <div class="md:col-span-3 font-mono text-xs text-[var(--text-dim)]">
                <span class="text-[var(--accent)]">0{idx + 1}</span> / {note.data.publishedAt} · {note.data.readingTime}
              </div>
              <div class="md:col-span-6">
                <h2 class="font-sans text-xl font-semibold text-[var(--text)] group-hover:text-[var(--accent)]">
                  {note.data.title}
                </h2>
                <p class="mt-2 text-sm text-[var(--text-dim)]">{note.data.summary}</p>
              </div>
              <div class="md:col-span-3 flex flex-wrap items-center gap-1.5 md:justify-end">
                {note.data.tags.map((tag) => (
                  <span class="rounded-[var(--radius-sm)] border border-[var(--line)] bg-[var(--surface)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-dim)]">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

