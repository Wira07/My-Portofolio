---
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";
import { getUses } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const categories = getUses();
---

<BaseLayout
  title={`${t(locale, "uses.title")} — ${t(locale, "meta.brand")}`}
  description={t(locale, "uses.subtitle")}
  locale={locale}
  path={localePath(locale, "/uses")}
  ogSlug="default"
>
  <section class="border-b border-[var(--line)] py-12 md:py-16">
    <div class="studio-container">
      <span class="mono-label text-[var(--accent)]">{t(locale, "nav.uses")}</span>
      <h1 class="page-h1 mt-3 max-w-4xl text-[var(--text)]" data-hero-line>{t(locale, "uses.title")}</h1>
      <p class="mt-4 max-w-2xl text-base text-[var(--text-dim)]" data-hero-line>{t(locale, "uses.subtitle")}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="studio-container space-y-10">
      {
        categories.map((cat) => (
          <div class="rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)] p-6">
            <div class="mb-4 flex items-center gap-3 border-b border-[var(--line)] pb-3">
              <span class="font-mono text-xs text-[var(--accent)]">{cat.code}</span>
              <h2 class="font-sans text-xl font-semibold text-[var(--text)]">{cat.title[locale]}</h2>
            </div>
            <ul class="divide-y divide-[var(--line)]">
              {cat.items.map((item) => (
                <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
                  <span class="font-mono text-sm font-medium text-[var(--text)]">{item.name}</span>
                  <span class="text-sm text-[var(--text-dim)]">{item.role[locale]}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

