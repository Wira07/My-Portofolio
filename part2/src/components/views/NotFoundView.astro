---
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/core/Button.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  title={`404 — ${t(locale, "meta.brand")}`}
  description={t(locale, "notFound.subtitle")}
  locale={locale}
  path="/404"
  noindex={true}
>
  <section class="py-24 md:py-32">
    <div class="studio-container max-w-3xl">
      <span class="mono-label text-[var(--accent)]">{t(locale, "notFound.code")}</span>
      <h1 class="page-h1 mt-4 text-[var(--text)]">{t(locale, "notFound.title")}</h1>
      <p class="mt-4 text-base text-[var(--text-dim)]">{t(locale, "notFound.subtitle")}</p>
      <div class="mt-8">
        <Button href={localePath(locale, "/")} variant="primary">
          {t(locale, "notFound.backHome")} →
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

