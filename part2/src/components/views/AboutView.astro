---
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";
import { getProfile } from "@/lib/content";
import { buildPersonJsonLd } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/core/Button.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile();
---

<BaseLayout
  title={`${t(locale, "about.title")} — ${t(locale, "meta.brand")}`}
  description={t(locale, "about.subtitle")}
  locale={locale}
  path={localePath(locale, "/about")}
  ogSlug="default"
  activeNav="about"
  jsonLd={buildPersonJsonLd(locale)}
>
  <section class="border-b border-[var(--line)] py-12 md:py-16">
    <div class="studio-container grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <span class="mono-label text-[var(--accent)]">{profile.ownerName}</span>
        <h1 class="page-h1 mt-3 text-[var(--text)]" data-hero-line>{t(locale, "about.title")}</h1>
        <p class="mt-4 max-w-2xl text-lg text-[var(--text-dim)]" data-hero-line>{t(locale, "about.subtitle")}</p>
        <div class="mt-6 flex flex-wrap gap-3 font-mono text-xs text-[var(--text-dim)]">
          <span class="rounded-[var(--radius-sm)] border border-[var(--line)] bg-[var(--surface)] px-3 py-1">
            {profile.location[locale]}
          </span>
          <span class="rounded-[var(--radius-sm)] border border-[var(--line)] bg-[var(--surface)] px-3 py-1">
            {profile.status[locale]}
          </span>
        </div>
      </div>

      <div class="lg:col-span-4">
        <div class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)]">
          <img
            src={profile.portrait}
            alt={t(locale, "about.portraitAlt")}
            width="640"
            height="720"
            loading="eager"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--line)] py-12 md:py-16">
    <div class="studio-container">
      <h2 class="mono-label text-[var(--accent)]">{t(locale, "about.pillarsTitle")}</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          profile.pillars[locale].map((p) => (
            <div class="rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] p-5">
              <span class="font-mono text-xs text-[var(--accent)]">{p.code}</span>
              <h3 class="mt-2 font-sans text-lg font-semibold text-[var(--text)]">{p.title}</h3>
              <p class="mt-2 text-sm text-[var(--text-dim)]">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--line)] py-12 md:py-16">
    <div class="studio-container grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h2 class="mono-label text-[var(--accent)]">{t(locale, "about.educationTitle")}</h2>
          {
            profile.education.map((ed) => (
              <div class="mt-4 rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] p-5">
                <div class="font-mono text-xs text-[var(--text-dim)]">{ed.period}</div>
                <h3 class="mt-1 font-sans text-lg font-semibold text-[var(--text)]">{ed.degree[locale]}</h3>
                <div class="text-sm text-[var(--accent)]">{ed.institution}</div>
                <p class="mt-2 text-sm text-[var(--text-dim)]">{ed.note[locale]}</p>
              </div>
            ))
          }
        </div>

        <div>
          <h2 class="mono-label text-[var(--accent)]">{t(locale, "about.certsTitle")}</h2>
          <ul class="mt-4 space-y-3">
            {
              profile.certifications.map((c) => (
                <li class="rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] p-4">
                  <div class="flex items-center justify-between font-mono text-xs text-[var(--text-dim)]">
                    <span>{c.org}</span>
                    <span>{c.year}</span>
                  </div>
                  <div class="mt-1 text-sm font-medium text-[var(--text)]">{c.title}</div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:col-span-7">
        <h2 class="mono-label text-[var(--accent)]">{t(locale, "about.experienceTitle")}</h2>
        <div class="mt-4 divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {
            profile.experience.map((exp) => (
              <div class="py-5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-sans text-lg font-semibold text-[var(--text)]">{exp.role}</h3>
                  <span class="font-mono text-xs text-[var(--accent)]">
                    {locale === "id" ? exp.period : exp.periodEn}
                  </span>
                </div>
                <div class="mt-1 font-mono text-xs text-[var(--text-dim)]">{exp.org}</div>
                <p class="mt-2 text-sm text-[var(--text-dim)]">{exp.summary[locale]}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)] p-6">
          <h2 class="font-sans text-xl font-semibold text-[var(--text)]">{t(locale, "about.ctaTitle")}</h2>
          <div class="mt-4 flex flex-wrap gap-3">
            <Button href={localePath(locale, "/engage")} variant="primary" magnetic={true}>
              {t(locale, "nav.engage")} →
            </Button>
            <Button href={profile.documents.cv} variant="secondary" download={true}>
              {t(locale, "footer.cvLabel")}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

