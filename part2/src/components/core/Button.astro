---
interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "secondary" | "ghost";
  magnetic?: boolean;
  download?: boolean | string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  id?: string;
  className?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  magnetic = false,
  download,
  target,
  rel,
  ariaLabel,
  id,
  className = ""
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-[var(--radius-md)] px-4 py-2.5 font-mono text-xs font-medium uppercase tracking-wider transition-colors duration-200 cursor-pointer no-underline";

const styles = {
  primary:
    "bg-[var(--accent)] text-[var(--accent-ink)] border border-[var(--accent)] hover:opacity-90",
  secondary:
    "bg-[var(--surface)] text-[var(--text)] border border-[var(--line)] hover:border-[var(--accent)] hover:text-[var(--accent)]",
  ghost:
    "bg-transparent text-[var(--text)] border border-transparent hover:border-[var(--line)]"
};

const cls = `${base} ${styles[variant]} ${className}`.trim();
---

{
  href ? (
    <a
      id={id}
      href={href}
      class={cls}
      data-magnetic={magnetic ? "true" : undefined}
      download={download}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  ) : (
    <button
      id={id}
      type={type}
      class={cls}
      data-magnetic={magnetic ? "true" : undefined}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}

