---
import type { Locale } from "@/lib/i18n";
import { t } from "@/lib/i18n";
import { getProfile } from "@/lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile();
const statusText = profile.status[locale];
const statusTitle = t(locale, "home.statusTitle");
---

<div class="inline-flex items-center gap-2.5 rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] px-3 py-1.5">
  <span class="relative flex h-2 w-2" aria-hidden="true">
    <span class="absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75 animate-ping"></span>
    <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--accent)]"></span>
  </span>
  <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-dim)]">{statusTitle}:</span>
  <span class="font-mono text-xs text-[var(--text)]">{statusText}</span>
</div>

