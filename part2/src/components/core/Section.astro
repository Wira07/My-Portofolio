---
interface Props {
  id?: string;
  index?: string;
  label: string;
  title?: string;
  subtitle?: string;
  borderTop?: boolean;
  className?: string;
}

const { id, index, label, title, subtitle, borderTop = true, className = "" } = Astro.props;
---

<section id={id} class={`py-16 md:py-24 ${borderTop ? "border-t border-[var(--line)]" : ""} ${className}`}>
  <div class="studio-container">
    <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
      <div class="max-w-3xl">
        <div class="mb-3 flex items-center gap-3">
          {index && (
            <span class="rounded-[var(--radius-sm)] border border-[var(--line)] bg-[var(--surface)] px-2 py-0.5 font-mono text-[11px] text-[var(--accent)]">
              {index}
            </span>
          )}
          <span class="mono-label text-[var(--text-dim)]">{label}</span>
        </div>
        {title && <h2 class="section-h2 text-[var(--text)]">{title}</h2>}
        {subtitle && <p class="mt-3 max-w-2xl text-base text-[var(--text-dim)]">{subtitle}</p>}
      </div>
      <div>
        <slot name="action" />
      </div>
    </div>
    <slot />
  </div>
</section>

