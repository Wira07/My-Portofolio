---
import type { WorkEntry } from "@/lib/content";
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";

interface CapabilityItem {
  id: string;
  code: string;
  title: Record<Locale, string>;
  summary: Record<Locale, string>;
  stack: string[];
  evidenceSlugs: string[];
}

interface Props {
  capability: CapabilityItem;
  locale: Locale;
  caseMap: Record<string, WorkEntry>;
}

const { capability, locale, caseMap } = Astro.props;
const evidenceItems = capability.evidenceSlugs.map((slug) => caseMap[slug]).filter(Boolean);
---

<details
  class="group border-b border-[var(--line)] py-6 transition-colors hover:bg-[var(--surface)]/50"
  open
>
  <summary class="studio-container flex cursor-pointer list-none flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="flex items-start gap-4 md:max-w-xl">
      <span class="mt-1 font-mono text-xs text-[var(--accent)]">{capability.code}</span>
      <div>
        <h3 class="font-sans text-xl font-semibold text-[var(--text)]">{capability.title[locale]}</h3>
        <p class="mt-1.5 text-sm text-[var(--text-dim)]">{capability.summary[locale]}</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 md:justify-end">
      {capability.stack.slice(0, 5).map((tech) => (
        <span class="rounded-[var(--radius-sm)] border border-[var(--line)] bg-[var(--surface)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-dim)]">
          {tech}
        </span>
      ))}
      <span class="ml-2 font-mono text-xs text-[var(--accent)] group-open:rotate-45 transition-transform">+</span>
    </div>
  </summary>

  <div class="studio-container mt-5 border-t border-[var(--line)]/60 pt-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <span class="mono-label text-[var(--text-dim)]">{t(locale, "capabilities.proofLabel")}:</span>
      <div class="flex flex-wrap gap-2">
        {evidenceItems.map((work) => (
          <a
            href={localePath(locale, `/work/${work.data.slug}`)}
            class="inline-flex items-center gap-2 rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] px-3 py-1.5 font-mono text-xs text-[var(--text)] no-underline transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            <span>{work.data.title}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</details>

