---
import type { WorkEntry } from "@/lib/content";
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";

interface Props {
  item: WorkEntry;
  locale: Locale;
  indexLabel: string;
}

const { item, locale, indexLabel } = Astro.props;
---

<header class="border-b border-[var(--line)] pb-12 pt-10 md:pt-14">
  <div class="studio-container">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <a
        href={localePath(locale, "/work")}
        class="link-underline font-mono text-xs uppercase tracking-wider text-[var(--text-dim)] hover:text-[var(--accent)]"
      >
        ← {t(locale, "work.backToWork")}
      </a>

      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-[var(--radius-sm)] border border-[var(--line)] bg-[var(--surface)] px-2 py-0.5 font-mono text-xs text-[var(--accent)]">
          {indexLabel}
        </span>
        {item.data.category.map((cat) => (
          <span class="rounded-[var(--radius-sm)] border border-[var(--line)] bg-[var(--surface)] px-2 py-0.5 font-mono text-xs uppercase text-[var(--text-dim)]">
            {t(locale, `work.categories.${cat}`)}
          </span>
        ))}
        {item.data.draft && (
          <span class="rounded-[var(--radius-sm)] border border-[var(--accent-2)]/60 px-2 py-0.5 font-mono text-xs text-[var(--accent-2)]">
            {t(locale, "work.draftBadge")}
          </span>
        )}
      </div>
    </div>

    <h1 class="page-h1 max-w-4xl text-[var(--text)]" data-hero-line>
      {item.data.title}
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-[var(--text-dim)]" data-hero-line>
      {item.data.summary}
    </p>

    {item.data.draft && (
      <div class="mt-6 rounded-[var(--radius-md)] border border-[var(--accent-2)]/40 bg-[var(--surface)] px-4 py-3 font-mono text-xs text-[var(--text-dim)]">
        {t(locale, "work.draftNotice")}
      </div>
    )}

    <div class="mt-8 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)]">
      <img
        src={item.data.cover}
        alt={item.data.coverAlt}
        width="1280"
        height="800"
        loading="eager"
        decoding="async"
        transition:name={`work-cover-${item.data.slug}`}
        class="aspect-[16/9] max-h-[540px] w-full object-cover"
      />
    </div>
  </div>
</header>

