---
import type { WorkEntry } from "@/lib/content";
import type { Locale } from "@/lib/i18n";
import { localePath, t } from "@/lib/i18n";
import { buildCanonicalUrl, buildWorkJsonLd } from "@/lib/seo";
import BaseLayout from "./BaseLayout.astro";
import CaseHero from "@/components/work/CaseHero.astro";
import CaseMeta from "@/components/work/CaseMeta.astro";
import ArchDiagram from "@/components/work/ArchDiagram.astro";
import MetricCounter from "@/components/work/MetricCounter.astro";

interface Props {
  item: WorkEntry;
  locale: Locale;
  indexLabel: string;
  prevItem?: WorkEntry;
  nextItem?: WorkEntry;
}

const { item, locale, indexLabel, prevItem, nextItem } = Astro.props;
const path = localePath(locale, `/work/${item.data.slug}`);
const jsonLd = buildWorkJsonLd({
  title: item.data.title,
  description: item.data.summary,
  url: buildCanonicalUrl(path),
  year: item.data.year,
  stack: item.data.stack
});
---

<BaseLayout
  title={`${item.data.title} — ${t(locale, "meta.brand")}`}
  description={item.data.summary}
  locale={locale}
  path={path}
  ogSlug={item.data.slug}
  activeNav="work"
  jsonLd={jsonLd}
>
  <article>
    <CaseHero item={item} locale={locale} indexLabel={indexLabel} />

    <div class="studio-container py-12 md:py-16">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
          <CaseMeta item={item} locale={locale} />
        </div>

        <div class="lg:col-span-8">
          <MetricCounter
            metrics={item.data.metrics}
            locale={locale}
            title={t(locale, "work.metricsTitle")}
          />

          <div class="prose-studio">
            <slot />
          </div>

          <ArchDiagram architecture={item.data.architecture} locale={locale} />

          {item.data.gallery.length > 0 && (
            <section class="mt-10 border-t border-[var(--line)] pt-8">
              <h2 class="mono-label mb-5 text-[var(--text-dim)]">{t(locale, "work.galleryTitle")}</h2>
              <div class="grid grid-cols-1 gap-6">
                {item.data.gallery.map((img) => (
                  <figure class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)]">
                    <img
                      src={img.src}
                      alt={img.alt}
                      width={img.width}
                      height={img.height}
                      loading="lazy"
                      decoding="async"
                      class="h-auto w-full object-cover"
                    />
                    <figcaption class="border-t border-[var(--line)] px-4 py-3 font-mono text-xs text-[var(--text-dim)]">
                      {img.caption}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}
        </div>
      </div>

      <nav
        aria-label={t(locale, "work.nextCase")}
        class="mt-16 grid grid-cols-1 gap-4 border-t border-[var(--line)] pt-8 sm:grid-cols-2"
      >
        <div>
          {prevItem && (
            <a
              href={localePath(locale, `/work/${prevItem.data.slug}`)}
              class="block rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] p-5 no-underline transition-colors hover:border-[var(--accent)]"
            >
              <span class="mono-label text-[var(--text-dim)]">← {t(locale, "work.prevCase")}</span>
              <div class="mt-2 font-sans text-lg font-semibold text-[var(--text)]">{prevItem.data.title}</div>
            </a>
          )}
        </div>
        <div>
          {nextItem && (
            <a
              href={localePath(locale, `/work/${nextItem.data.slug}`)}
              class="block rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--surface)] p-5 text-right no-underline transition-colors hover:border-[var(--accent)]"
            >
              <span class="mono-label text-[var(--text-dim)]">{t(locale, "work.nextCase")} →</span>
              <div class="mt-2 font-sans text-lg font-semibold text-[var(--text)]">{nextItem.data.title}</div>
            </a>
          )}
        </div>
      </nav>
    </div>
  </article>
</BaseLayout>

